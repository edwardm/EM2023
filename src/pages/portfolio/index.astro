---
import Layout from "../../layouts/Default.astro";
import PortfolioFeatured from "../../components/PortfolioFeatured.astro";
const title = "Portfolio";
const description =
	"A curated portfolio of UX, product, visual design, and design systems work.";
---

<Layout title={title} description={description}>
	<section class="row title">
		<div class="col-sm-9">
			<div class="row">
				<h1 class="col-12 mb-2">Portfolio</h1>
				<h2 class="col-12 mb-5 pb-5 description">
					A curated list of works showcasing UX, product and visual
					design
				</h2>
			</div>
		</div>
	</section>
	<PortfolioFeatured />
</Layout>
