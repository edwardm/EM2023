---
import Layout from "../layouts/Default.astro";
const title = "Contact Me";
const description =
	"Get in touch with Edward Margallo about a project, collaboration, or question.";
---

<Layout title={title} description={description}>
	<section class="row title">
		<h1 class="col-12 mb-2">{title}</h1>
		<h2 class="col-12 mb-5 pb-5 description">
			Have comments, suggestions or need help on a project?
		</h2>
	</section>
	<section class="row gx-md-5">
		<div class="col-xl-7 mb-5">
			<div class="card card-normal">
				<h3>Send me a message</h3>
				<form
					id="contact-form"
					action="https://formspree.io/f/xyyqwznb"
					method="POST"
					data-bs-theme="dark">
					<div class="row">
						<div class="col-xl-6">
							<div class="form-floating mb-4">
								<input
									id="name"
									type="text"
									name="name"
									class="form-control"
									required
								/>
								<label for="name">Name:</label>
							</div>
						</div>
						<div class="col-xl-6">
							<div class="form-floating mb-4">
								<input
									id="email"
									type="email"
									name="email"
									class="form-control"
									required
								/>
								<label for="email">Email:</label>
							</div>
						</div>
					</div>
					<div class="form-floating mb-5">
						<textarea
							id="message"
							name="message"
							class="form-control contact-message"
							required
							rows="10">
						</textarea>
						<label for="message">Message:</label>
					</div>
					<div class="text-center">
						<button type="submit" class="btn btn-primary">
							Submit
						</button>
						<p
							id="contact-form-status"
							class="mt-4"
							role="status"
							aria-live="polite">
						</p>
					</div>
				</form>
			</div>
		</div>
		<div class="col-xl-1"></div>
		<div class="col-xl-4 mb-5">
			<h3>Other ways to find me&hellip;</h3>
			<ul class="big-icons">
				<li>
					<a
						href="mailto:contact@edwardmargallo.com?subject=Email%20from%20EdwardMargallo.com">
						<i class="fa-fw fa-regular fa-envelope"></i> Direct
						email
					</a>
				</li>
				<li>
					<a
						href="https://www.linkedin.com/in/edwardmargallo/"
						target="_blank"
						rel="noopener noreferrer">
						<i class="fa-fw fa-brands fa-linkedin"></i> LinkedIn
					</a>
				</li>
				<li>
					<a
						href="https://github.com/edwardm"
						target="_blank"
						rel="noopener noreferrer">
						<i class="fa-fw fa-brands fa-square-github"></i> Github
					</a>
				</li>
				<li>
					<a
						href="https://www.behance.net/edwardmargallo"
						target="_blank"
						rel="noopener noreferrer">
						<i class="fa-fw fa-brands fa-square-behance"></i>
						 Behance
					</a>
				</li>
				<li>
					<a
						href="https://dribbble.com/etmargallo"
						target="_blank"
						rel="noopener noreferrer">
						<i class="fa-fw fa-brands fa-square-dribbble"></i>
						 Dribbble
					</a>
				</li>
				<li>
					<a
						href="https://stackoverflow.com/users/286455/edwardm"
						target="_blank"
						rel="noopener noreferrer">
						<i class="fa-fw fa-brands fa-stack-overflow"></i> Stack
						Overflow
					</a>
				</li>
			</ul>
		</div>
	</section>
</Layout>
